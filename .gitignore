Thumbs.db

# Logs and local market/binary data ONLY at repo root.
# CRITICAL: use /data/ (anchored). A bare `data/` also matched and excluded
# Python packages iqrp/app/data and iqrp/app/backtesting/data from GitHub clones.
logs/
/data/
*.log
*.duckdb
*.duckdb.wal
# Never ignore the Python source packages named "data"
!iqrp/app/data/
!iqrp/app/data/**
!iqrp/app/backtesting/data/
!iqrp/app/backtesting/data/**
# Still ignore caches inside those packages
iqrp/app/data/**/__pycache__/
iqrp/app/backtesting/data/**/__pycache__/

